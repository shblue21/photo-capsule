{
  "name": "photo-capsule",
  "version": "1.0.0",
  "description": "Photo Capsule \u2014 collect event photos and reveal them together",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "tsc && node -e \"require('fs').cpSync('src/views','dist/src/views',{recursive:true})\"",
    "start": "node dist/src/index.js",
    "dev": "ts-node --files src/index.ts",
    "test": "jest --runInBand --forceExit",
    "test:coverage": "jest --runInBand --forceExit --coverage"
  },
  "dependencies": {
    "ejs": "3.1.10",
    "express": "^4.22.3",
    "multer": "2.4.0",
    "qrcode": "1.5.3",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/ejs": "3.1.5",
    "@types/express": "4.17.21",
    "@types/jest": "30.0.0",
    "@types/multer": "1.4.11",
    "@types/node": "22.0.0",
    "@types/qrcode": "1.5.5",
    "@types/supertest": "6.0.2",
    "fast-check": "^4.10.2",
    "jest": "30.5.2",
    "supertest": "7.0.0",
    "ts-jest": "29.4.14",
    "ts-node": "10.9.2",
    "typescript": "5.4.5"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.ts"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.json"
        }
      ]
    }
  },
  "engines": {
    "node": ">=24"
  }
}
