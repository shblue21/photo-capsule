<style>

:root{--bg:#f7f7fc;--card:#fff;--ink:#242339;--muted:#77758b;--accent:#7461db;--accent-hover:#6250c5;--line:#e9e7f2;--bad:#b63a56;--soft:#f1edff}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font-family:-apple-system,BlinkMacSystemFont,'Apple SD Gothic Neo','Noto Sans KR',sans-serif;line-height:1.6;-webkit-font-smoothing:antialiased}
.wrap{max-width:900px;margin:auto;padding:36px 28px 64px}.brand{display:inline-flex;align-items:center;gap:9px;color:var(--ink);text-decoration:none;font-size:17px;font-weight:800;letter-spacing:-.05em;min-height:44px}.brand-icon{display:grid;place-items:center;background:var(--accent);color:white;width:34px;height:34px;border-radius:11px;font-size:25px;box-shadow:0 4px 12px #7461db20}.brand-en{font-size:9px;font-weight:650;letter-spacing:.16em;color:#9c98ae;margin-left:7px}
h1{font-size:clamp(30px,4vw,44px);line-height:1.3;letter-spacing:-.065em;margin:26px 0 12px;font-weight:750}h2{font-size:20px;letter-spacing:-.04em;margin:0 0 10px}p{color:var(--muted);margin:10px 0 16px}.card{background:var(--card);border:1px solid var(--line);border-radius:24px;padding:30px;margin:24px 0;box-shadow:0 8px 36px #30256505}.eyebrow{font-size:12px;letter-spacing:.05em;color:var(--accent);font-weight:650}.pill{display:inline-flex;align-items:center;background:var(--soft);color:#6552bc;border-radius:100px;padding:6px 13px;font-size:12px;font-weight:600}.muted,.hint{color:var(--muted);font-size:12px;line-height:1.7}label{display:block;font-size:13px;font-weight:650;margin:20px 0 8px;color:#48465d}.optional{font-size:11px;font-weight:400;color:#9691a7;margin-left:5px}.required{color:var(--accent)}input,textarea{font:inherit;font-size:14px;width:100%;padding:13px 15px;border:1px solid #e4e2ee;border-radius:11px;background:#fcfcff;color:var(--ink);transition:border-color .18s,box-shadow .18s}input{min-height:48px}input::placeholder,textarea::placeholder{color:#aaa5b8}textarea{resize:vertical;min-height:76px}input:focus,textarea:focus{border-color:var(--accent);box-shadow:0 0 0 3px #7461db12;outline:none}button,.button{font:inherit;font-size:14px;min-height:46px;padding:12px 18px;border:0;border-radius:11px;background:var(--accent);color:white;cursor:pointer;display:inline-flex;align-items:center;justify-content:center;gap:10px;text-decoration:none;font-weight:650;transition:background .18s,transform .18s,box-shadow .18s}button:hover,.button:hover{background:var(--accent-hover);box-shadow:0 5px 18px #7461db20}button:active,.button:active{transform:translateY(1px)}button:disabled{opacity:.5;cursor:default;box-shadow:none}.secondary{background:var(--soft);color:#6c5aaf}.secondary:hover{background:#e8e0ff}.wide{width:100%;margin-top:16px}.row{display:flex;gap:10px;flex-wrap:wrap}.row>*{flex:1}:focus-visible{outline:3px solid #ab9aee;outline-offset:3px}.error{color:var(--bad)}.status{white-space:pre-line;font-size:13px}.status:empty{display:none}.token{word-break:break-all;font:12px/1.7 ui-monospace,monospace;background:#f7f5fd;border:1px solid var(--line);padding:14px;border-radius:12px}.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:16px}.photo{padding:8px;background:white;border:1px solid var(--line);border-radius:17px;box-shadow:0 4px 14px #34265808}.photo img{width:100%;aspect-ratio:1;object-fit:cover;border-radius:11px;display:block}.photo button{width:100%;font-size:12px}.open-photo{display:block;padding:0;background:none;width:100%;border-radius:11px}.open-photo:hover{background:none;transform:translateY(-2px)}.drop{border:1.5px dashed #cfc4ef;border-radius:17px;padding:26px;text-align:center;background:#faf8ff}.drop label{color:#6c57af;margin-top:0}.drop input{background:white;border:1px solid var(--line);font-size:12px}.drop.over{background:#eee6ff;border-color:var(--accent)}progress{width:100%;accent-color:var(--accent);height:7px;margin-top:15px}dialog{border:1px solid var(--line);border-radius:24px;max-width:min(94vw,960px);padding:22px;box-shadow:0 24px 90px #1c153e44}dialog::backdrop{background:#242036c9;backdrop-filter:blur(8px)}dialog img{max-width:100%;max-height:65vh;display:block;margin:0 auto 18px;border-radius:12px}.qr{display:block;width:190px;height:190px;margin:24px auto;padding:10px;border:1px solid var(--line);border-radius:16px}.hidden{display:none!important}footer{font-size:11px;line-height:1.8;color:#9590a4;margin-top:28px}summary{cursor:pointer;font-size:12px;color:var(--muted)}
/* Home: a compact creation surface with an album preview. */
.home{background:radial-gradient(ellipse at 20% 42%,#eee9ff77,transparent 55%),#f8f8fc}.home-wrap{max-width:1160px;padding:30px 40px 24px}.nav{display:flex;align-items:center;justify-content:space-between;padding-bottom:24px;border-bottom:1px solid #eae7f1}.nav-note{display:flex;align-items:center;gap:7px;font-size:11px;color:#8f899f}.dot{width:5px;height:5px;border-radius:50%;background:#ab99e7}.home-grid{display:grid;grid-template-columns:1.15fr 1fr;gap:70px;align-items:center;padding:38px 0 28px}.intro h1{font-size:40px;margin:13px 0 17px;line-height:1.35;letter-spacing:-.065em}.accent{color:var(--accent)}.lead{font-size:14px;line-height:1.9;color:#868097}.create-card{margin:0;padding:30px 32px;border:1px solid #e9e4f6;box-shadow:0 14px 65px #5b40950a}.form-heading{display:flex;align-items:center;gap:12px;padding-bottom:18px;border-bottom:1px solid #f0edf6}.form-heading h2{font-size:19px;margin:0 0 3px}.form-heading p{font-size:11px;margin:0;color:#9790a7}.form-icon{display:grid;place-items:center;width:38px;height:38px;background:var(--soft);border-radius:12px;color:var(--accent);font-size:24px;font-weight:300}.create-card label{margin-top:19px}.hint{font-size:11px;margin:8px 0 13px}.quick-button{background:none;border:1px solid #e6e0f6;color:#8370bc;font-size:11px;min-height:44px;padding:7px 11px;border-radius:8px}.quick-button:hover{background:var(--soft);box-shadow:none}.primary-create{margin-top:19px;min-height:49px;box-shadow:0 6px 18px #7461db24}.primary-create span{font-size:18px;position:absolute;right:19px}.primary-create{position:relative}.form-foot{font-size:10px;color:#9a94a8;text-align:center;margin-top:15px}.form-foot span{margin-right:3px}.album-preview{position:relative;height:285px;margin:10px 0 8px}.orbit{position:absolute;border:1px solid #dfd6f1;border-radius:50%;width:275px;height:215px;left:60px;top:26px;transform:rotate(-23deg)}.orbit-two{width:330px;height:240px;left:30px;top:10px;opacity:.45;transform:rotate(18deg)}.print{position:absolute;width:180px;background:white;border:1px solid #f1ecf8;border-radius:4px;padding:10px 10px 8px;box-shadow:0 15px 30px #41315c13;margin:0}.print img{display:block;width:100%;height:156px;object-fit:cover;border-radius:2px}.print figcaption{font-size:10px;color:#8b819c;padding:12px 2px 4px;letter-spacing:-.02em}.print figcaption span{float:right;color:#b2a1d6}.print-back{left:200px;top:12px;transform:rotate(11deg)}.print-front{left:51px;top:33px;transform:rotate(-10deg)}.preview-note{position:absolute;left:164px;bottom:12px;display:flex;gap:10px;align-items:center;padding:12px 14px;background:#ffffffec;border:1px solid #efeaf9;border-radius:13px;box-shadow:0 8px 25px #4632660b;transform:rotate(-3deg)}.note-icon{width:32px;height:32px;display:grid;place-items:center;background:#f3edff;border-radius:9px;color:#9e84db}.preview-note strong{display:block;font-size:11px;font-weight:650}.preview-note small{display:block;font-size:9px;color:#a098af;margin-top:2px}.tiny-lock{color:#a695c2;margin-left:12px}.floating-spark{position:absolute;left:25px;top:9px;color:#bfaadf;font-size:30px}.steps{display:flex;align-items:center;justify-content:space-between;gap:12px;max-width:400px;margin-top:12px}.steps div{display:flex;align-items:center;gap:7px}.steps b{display:grid;place-items:center;font-size:9px;border:1px solid #e2d9f0;border-radius:50%;width:24px;height:24px;color:#a494be;font-weight:500}.steps span{font-size:10px;color:#8b819c}.steps i{font-style:normal;font-size:12px;color:#c3b8d5}.home-footer{border-top:1px solid #eae7f1;display:flex;justify-content:space-between;align-items:flex-start;gap:30px;padding-top:18px;margin:0;font-size:10px}.home-footer details{max-width:350px;text-align:right}.home-footer summary{font-size:10px}.home-footer p{font-size:11px;text-align:left}
@media(min-width:1440px){.home-wrap{padding-top:50px}.home-grid{padding:60px 0}}
@media(max-width:1000px){.home-grid{gap:35px}.intro h1{font-size:34px}.print-back{left:160px}.print-front{left:22px}.preview-note{left:120px}.orbit{left:20px}.orbit-two{left:0}.album-preview{transform:scale(.94);transform-origin:left center}.home-wrap{padding:24px 28px}}
@media(max-width:760px){.home-grid{grid-template-columns:1fr;gap:24px;padding:28px 0}.home-wrap{max-width:520px;padding:20px}.nav{padding-bottom:18px}.brand-en{display:none}.nav-note{font-size:10px}.intro h1{font-size:32px;margin:10px 0 12px}.lead{font-size:13px;margin-bottom:0}.album-preview{height:192px;transform:none;margin:13px 0 0}.print{width:125px;padding:7px}.print img{height:103px}.print figcaption{font-size:8px;padding:7px 1px 2px}.print-front{left:45px;top:14px}.print-back{left:159px;top:0}.orbit{width:218px;height:148px;left:40px;top:2px}.orbit-two{width:280px;height:161px;left:15px;top:0}.preview-note{left:170px;bottom:11px;padding:8px 10px;gap:6px}.preview-note strong{font-size:9px}.preview-note small{font-size:8px}.note-icon{width:25px;height:25px}.tiny-lock{margin-left:0}.floating-spark{left:12px;top:4px}.steps{margin-top:6px}.create-card{padding:24px}.home-footer{display:block}.home-footer details{text-align:left;margin-top:6px}.grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.wrap{padding:24px 20px 48px}.row>*{min-width:120px}.card{padding:23px}.form-heading h2{font-size:18px}}
@media(prefers-reduced-motion:reduce){*{transition:none!important}}
@media(max-width:360px){.album-preview{overflow:hidden}.orbit-two{width:calc(100% - 15px)}}

</style>