<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Your capsule is ready</title><%- include("style") %></head><body><main class="wrap"><a class="brand" href="/">PHOTO CAPSULE</a><h1>Time to collect some memories.</h1><p><%= album.title %> · <%= revealDate %> · reveal</p><section class="card"><h2>Invite your people</h2><img class="qr" src="<%= qrDataUrl %>" alt="Album invitation QR code"><p class="token" id="invite"><%= inviteUrl %></p><div class="row"><button id="copy">Copy invite link</button><a class="button secondary" href="<%= inviteUrl %>">Open guest view</a></div><p id="copyStatus" role="status"></p><p class="muted">Local demo: this localhost link and QR work only on this computer.</p></section><section class="card"><h2>Manage your capsule</h2><p>Use this private management key to review and remove photos. Keep it separate from the invitation link.</p><details><summary>Show and save management key</summary><p class="token" id="secret"><%= hostSecret %></p><button class="secondary" id="saveKey">Save management details</button></details><a class="button wide" href="/host/<%= albumId %>">Manage capsule →</a></section></main><script>
const id='<%= albumId %>';const secret=document.getElementById('secret').textContent;sessionStorage.setItem('host:'+id,secret);
document.getElementById('copy').onclick=async()=>{try{await navigator.clipboard.writeText(document.getElementById('invite').textContent);document.getElementById('copyStatus').textContent='Link copied.';}catch{document.getElementById('copyStatus').textContent='Please select and copy the link above.';}};
document.getElementById('saveKey').onclick=()=>{const blob=new Blob([JSON.stringify({albumId:id,managementUrl:location.origin+'/host/'+id,managementKey:secret},null,2)],{type:'application/json'});const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='photo-capsule-management.json';a.click();setTimeout(()=>URL.revokeObjectURL(a.href),1000);};
</script></body></html>