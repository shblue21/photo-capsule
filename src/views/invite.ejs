<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Photo Capsule — <%= album.title %></title><%- include("style") %></head><body><main class="wrap"><a class="brand" href="/">PHOTO CAPSULE</a><h1><%= album.title %></h1><p><%= album.description || 'Share the moments only you captured.' %></p><span class="pill"><%= revealed ? 'Your capsule is open' : 'A surprise worth waiting for' %></span><p class="muted"><%= revealDate %> · reveal</p><% if(!revealed){ %><section class="card"><h2>What did you capture?</h2><p>Everyone’s photos will be revealed at the agreed time.</p><div class="drop" id="zone"><label for="files">Choose photos or drop them here</label><input id="files" type="file" accept="image/jpeg,image/png,image/webp,image/gif" multiple><p class="muted">20 MB per photo · 200 photos per album<br>Location metadata is removed. GIFs are saved as a single frame.</p></div><ul id="list"></ul><progress id="progress" max="100" value="0" aria-label="Photo upload progress"></progress><button class="wide" id="upload" disabled>Choose your photos</button><p class="status" id="status" role="status" aria-live="polite"></p><p class="muted" id="countdown"></p></section><% } else { %><section class="card"><h2>Our moments, together</h2><p id="status" role="status">Loading your photos…</p><div class="grid" id="grid"></div></section><% } %><footer>Anyone with this invitation can view the album after reveal.<br>Hosts can review photos before reveal.</footer><dialog id="viewer" aria-label="View photo"><img id="large" alt="Selected photo"><div class="row"><a class="button" id="download" download="photo.jpg">Save photo</a><button class="secondary" id="close">Close</button></div></dialog></main><script>
const token='<%= inviteToken %>',albumId='<%= album.id %>',revealed=<%= revealed %>;const headers={'X-Invite-Token':token};const status=document.getElementById('status');const viewer=document.getElementById('viewer');document.getElementById('close').onclick=()=>viewer.close();let urls=[];
if(!revealed){let pending=[];const files=document.getElementById('files'),btn=document.getElementById('upload'),list=document.getElementById('list'),zone=document.getElementById('zone');function render(){list.replaceChildren();for(const f of pending){const li=document.createElement('li');li.textContent=f.name+' · '+(f.size/1048576).toFixed(1)+' MB';list.append(li);}btn.disabled=!pending.length;btn.textContent=pending.length?'Add '+pending.length+(pending.length===1?' photo':' photos'):'Choose your photos';}files.onchange=()=>{pending=Array.from(files.files);render();};zone.ondragover=e=>{e.preventDefault();zone.classList.add('over');};zone.ondragleave=()=>zone.classList.remove('over');zone.ondrop=e=>{e.preventDefault();zone.classList.remove('over');pending=Array.from(e.dataTransfer.files);render();};
const restoreDrop=zone.ondrop;
function send(file){return new Promise((resolve,reject)=>{const x=new XMLHttpRequest();x.open('POST','/albums/'+albumId+'/photos');x.setRequestHeader('X-Invite-Token',token);x.timeout=60000;x.upload.onprogress=e=>{if(e.lengthComputable)document.getElementById('progress').value=e.loaded/e.total*100;};x.onload=()=>{let j={};try{j=JSON.parse(x.responseText);}catch{}x.status===201?resolve(j):reject(new Error(j.error||'Upload failed'));};x.onerror=()=>reject(new Error('Check your connection and try again.'));x.ontimeout=()=>reject(new Error('The upload timed out. Please try again.'));const fd=new FormData();fd.append('photo',file);x.send(fd);});}
btn.onclick=async()=>{btn.disabled=true;files.disabled=true;zone.ondrop=e=>e.preventDefault();const retry=[],errors=[];let ok=0;const total=pending.length;for(const [i,f] of pending.entries()){status.textContent=(i+1)+' / '+total+(total===1?' photo uploading…':' photos uploading…');try{await send(f);ok++;}catch(e){retry.push(f);errors.push(f.name+': '+e.message);}}pending=retry;files.value='';files.disabled=false;zone.ondrop=restoreDrop;render();status.textContent=ok+(ok===1?' photo added.':' photos added.')+(errors.length?'\n'+errors.join('\n'):' See you at the reveal!');if(retry.length)btn.textContent='Retry '+retry.length+(retry.length===1?' photo':' photos');};
const delay=<%= Math.max(0, album.reveal_at-serverNow) %>,start=performance.now();setInterval(()=>{const remaining=delay-(performance.now()-start);if(remaining<=0){location.reload();return;}document.getElementById('countdown').textContent='Opening in about '+Math.ceil(remaining/1000)+' seconds.';},1000);
}else{(async()=>{try{const r=await fetch('/albums/'+albumId+'/photos',{headers});if(!r.ok)throw new Error('Could not load the photo list.');const j=await r.json();status.textContent=j.photos.length?j.photos.length+(j.photos.length===1?' shared moment.':' shared moments.'):'No photos were added.';for(const [i,p] of j.photos.entries()){const response=await fetch('/albums/'+albumId+'/photos/'+p.id,{headers});if(!response.ok)continue;const url=URL.createObjectURL(await response.blob());urls.push(url);const card=document.createElement('div');card.className='photo';const button=document.createElement('button');button.className='open-photo';button.setAttribute('aria-label','Photo '+(i+1)+' — open photo');const img=document.createElement('img');img.src=url;img.alt='Our moment '+(i+1);button.append(img);button.onclick=()=>{document.getElementById('large').src=url;document.getElementById('download').href=url;viewer.showModal();};card.append(button);document.getElementById('grid').append(card);}}catch(e){status.textContent=e.message;}})();}window.addEventListener('pagehide',()=>urls.forEach(URL.revokeObjectURL));
</script></body></html>