<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Photo Capsule — Capture together. Open together.</title><%- include("style") %></head>
<body class="home"><main class="wrap home-wrap">
<nav class="nav"><a class="brand" href="/"><span class="brand-icon">▧</span> Photo Capsule<span class="brand-en">SHARED ALBUMS</span></a><span class="nav-note"><span class="dot"></span> Made for shared memories</span></nav>
<div class="home-grid"><section class="intro"><span class="eyebrow">TODAY’S MOMENTS. TOMORROW’S GIFT.</span><h1>Moments together.<br>Memories to unwrap<span class="accent">.</span></h1><p class="lead">Bring everyone’s photos into one little capsule.<br>Invite your people. Add your moments. Open together.</p>
<div class="album-preview" aria-label="Illustrated shared album preview">
 <div class="orbit orbit-one"></div><div class="orbit orbit-two"></div>
 <figure class="print print-back"><img src="data:image/jpeg;base64," alt="Sample sunset illustration"><figcaption>Chasing the sunset</figcaption></figure>
 <figure class="print print-front"><img src="data:image/jpeg;base64," alt="Sample mountain illustration"><figcaption>Our autumn getaway <span>♡</span></figcaption></figure>
 <div class="preview-note"><span class="note-icon">✦</span><div><strong>Collecting moments</strong><small>A little surprise, for later</small></div><span class="tiny-lock">◷</span></div>
 <span class="floating-spark">✧</span>
</div>
<div class="steps"><div><b>01</b><span>Create capsule</span></div><i>→</i><div><b>02</b><span>Invite with a QR</span></div><i>→</i><div><b>03</b><span>Open together</span></div></div>
</section>
<section class="card create-card"><div class="form-heading"><span class="form-icon">＋</span><div><h2>Start a little time capsule</h2><p>A shared album for your favorite people.</p></div></div>
<form id="form" method="post" action="/create">
<label for="title">Capsule name <span class="required">*</span></label><input id="title" name="title" required maxlength="100" placeholder="e.g. Our autumn getaway">
<label for="description">A note for everyone <span class="optional">optional</span></label><textarea id="description" name="description" maxlength="500" rows="2" placeholder="A few words to remember this moment"></textarea>
<label for="when">When should it open? <span class="required">*</span></label><input id="when" type="datetime-local" required><input id="instant" name="revealAt" type="hidden">
<p class="hint">Collect photos until this time, then reveal them together.</p>
<button type="button" class="quick-button" id="quick"><span>◷</span> Quick demo · opens in 1 minute</button>
<p class="error status" id="error" role="alert"></p><button class="wide primary-create" type="submit">Create capsule <span>↗</span></button>
<div class="form-foot"><span>◇</span> Guests can upload from their browser. No app needed.</div>
</form></section></div>
<footer class="home-footer"><span>Little moments. One shared story.</span><details><summary>Sharing & privacy</summary><p>Anyone with the invite link can view photos after reveal. Hosts can review photos beforehand. This demo runs locally on this computer.</p></details></footer>
</main><script>
const when=document.getElementById('when');const local=d=>new Date(d.getTime()-d.getTimezoneOffset()*60000).toISOString().slice(0,16);when.value=local(new Date(Date.now()+3600000));let quick=false;
document.getElementById('quick').onclick=()=>{quick=true;when.value=local(new Date(Date.now()+60000));document.getElementById('quick').textContent='✓ Demo selected · opens 1 minute after creation';};when.oninput=()=>quick=false;
document.getElementById('form').onsubmit=e=>{const dt=quick?new Date(Date.now()+60000):new Date(when.value);if(!Number.isFinite(dt.getTime())||dt<=new Date()){e.preventDefault();document.getElementById('error').textContent='Please choose a time in the future.';return;}document.getElementById('instant').value=dt.toISOString();};
</script></body></html>