<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Manage Photo Capsule</title><%- include("style") %></head><body><main class="wrap"><a class="brand" href="/">PHOTO CAPSULE</a><h1 id="title">Manage your capsule</h1><section class="card" id="login"><h2>Enter with your management key</h2><form onsubmit="event.preventDefault();secret=document.getElementById('key').value.trim();if(secret)load();"><label for="key">The key you received when creating this capsule</label><input id="key" type="password" autocomplete="off"><button class="wide" type="submit">Open dashboard</button></form></section><p id="status" class="status" role="status"></p><section id="dashboard" class="hidden"><div class="card"><span class="pill" id="state"></span><p id="when"></p><p class="token" id="invite"></p><div class="row"><button id="copy">Copy invite link</button><a class="button secondary" id="visit">Guest view</a></div><img id="qr" class="qr" alt="Invitation QR code"></div><section class="card"><h2>Collected photos <span id="count"></span></h2><p class="muted">Hosts can review photos before reveal. Deleted photos cannot be recovered.</p><div class="grid" id="grid"></div><p id="empty"></p></section><button class="secondary" id="logout">Forget the key in this tab</button></section></main><script>
const albumId='<%= albumId %>';let secret=sessionStorage.getItem('host:'+albumId)||'';const status=document.getElementById('status');let urls=[];
const headers=()=>({Authorization:'Bearer '+secret});
async function load(){try{const r=await fetch('/host/'+albumId+'/json',{headers:headers()});const j=await r.json();if(!r.ok)throw new Error('The management key is not valid.');sessionStorage.setItem('host:'+albumId,secret);document.getElementById('login').classList.add('hidden');document.getElementById('dashboard').classList.remove('hidden');document.getElementById('title').textContent=j.album.title;document.getElementById('state').textContent=j.revealed?'Open for everyone':'Collecting photos';document.getElementById('when').textContent=new Date(j.album.reveal_at).toLocaleString('en-US',{timeZone:'UTC',timeZoneName:'short'})+' · reveal';const invite=location.origin+j.inviteUrl;document.getElementById('invite').textContent=invite;document.getElementById('visit').href=invite;document.getElementById('count').textContent=j.photoCount+(j.photoCount===1?' photo':' photos');document.getElementById('empty').textContent=j.photoCount?'':'No photos yet. Open the invite link to add the first one.';
urls.forEach(URL.revokeObjectURL);urls=[];const qr=await fetch('/host/'+albumId+'/qr',{headers:headers()});if(qr.ok){const u=URL.createObjectURL(await qr.blob());urls.push(u);document.getElementById('qr').src=u;}const grid=document.getElementById('grid');grid.replaceChildren();for(const [index,p] of j.photos.entries()){const card=document.createElement('div');card.className='photo';const img=document.createElement('img');img.alt='Collected photos '+(index+1);const pr=await fetch('/albums/'+albumId+'/photos/'+p.id,{headers:headers()});if(pr.ok){const u=URL.createObjectURL(await pr.blob());urls.push(u);img.src=u;}card.append(img);const del=document.createElement('button');del.className='secondary';del.textContent='Delete';del.setAttribute('aria-label','Photo '+(index+1)+' Delete');let armed=false;del.onclick=async()=>{if(!armed){armed=true;del.textContent='Confirm deletion?';setTimeout(()=>{armed=false;del.textContent='Delete';},4000);return;}del.disabled=true;const dr=await fetch('/albums/'+albumId+'/photos/'+p.id,{method:'DELETE',headers:headers()});if(!dr.ok){status.textContent='Could not delete the photo. Please try again.';del.disabled=false;return;}await load();status.textContent='Photo deleted.';};card.append(del);grid.append(card);}status.textContent='';}catch(e){status.textContent=e.message;document.getElementById('login').classList.remove('hidden');}}
document.getElementById('copy').onclick=async()=>{try{await navigator.clipboard.writeText(document.getElementById('invite').textContent);status.textContent='Invite link copied.';}catch{status.textContent='Please copy the link manually.';}};document.getElementById('logout').onclick=()=>{sessionStorage.removeItem('host:'+albumId);location.reload();};if(secret)load();
</script></body></html>